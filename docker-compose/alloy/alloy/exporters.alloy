// Backend destinations for logs, metrics, and traces.

// Send logs to Loki.
loki.write "loki" {
  endpoint {
    url        = env("LOKI_URL")
    batch_wait = "5s"

    basic_auth {
      username = env("LOKI_USER")
      password = env("LOKI_PASSWORD")
    }
  }
}

// Send metrics to Mimir.
prometheus.remote_write "mimir" {
  endpoint {
    url = env("PROM_URL")

    basic_auth {
      username = env("PROM_USER")
      password = env("PROM_PASSWORD")
    }
  }
}

// Send traces to Tempo.
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = env("TEMPO_URL")

    tls {
      insecure = true
    }
  }
}
